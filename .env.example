# NeuralSpace — environment variables
# Copy to .env.local and fill in. Never commit .env.local (it is gitignored).

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Site ---
NEXT_PUBLIC_SITE_URL=

# --- Cloudinary (media uploads) ---
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Gemini (translation pipeline, lib/i18n/) ---
# Comma-separated. The round-robin pool in lib/i18n/gemini.ts rotates over these
# and benches any key that returns 429 or 5xx for 60 seconds.
GEMINI_API_KEYS=
GEMINI_MODEL=

# --- Email (Resend) ---
RESEND_API_KEY=
EMAIL_FROM=

# --- Redis ---
REDIS_URL=

# --- Admin access ---
ADMIN_EMAILS=

# --- Cron ---
# Required by /api/i18n/translate on scheduled invocations.
CRON_SECRET=
